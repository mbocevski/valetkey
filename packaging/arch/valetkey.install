post_install() {
  echo 'To start the valetkey daemon when a client connects, run as your user:'
  echo '    systemctl --user enable --now valetkeyd.socket'
  echo 'Then run `valetkey doctor` to check the rest of the setup.'
}

post_upgrade() {
  echo 'Restart the daemon to use the new version:'
  echo '    systemctl --user try-restart valetkeyd.service'
}
